DATABASE_URL="postgresql://metalhr:metalhr@localhost:5432/metalhr?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; values starting with "replace-with" are rejected in production.
JWT_SECRET="replace-with-a-long-access-token-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-long-refresh-token-secret-at-least-32-chars"

PORT=8081
# Comma-separated list of allowed browser origins (Angular :4200, Vite/React :5173, CRA/Next :3000).
CORS_ORIGIN="http://localhost:4200,http://localhost:5173,http://localhost:3000"
# Public URL of the frontend, used in e-mailed links.
FRONTEND_URL="http://localhost:5173"
# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs / rate limiting.
TRUST_PROXY=1
NODE_ENV="development"

# Leave SMTP_HOST empty in development: e-mails are only logged (never with passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI assistant: any OpenAI-compatible provider; leave LLM_BASE_URL or LLM_MODEL empty to disable it.
#   Groq   (free):  LLM_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.3-70b-versatile
#   Gemini (free):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.0-flash
#   Ollama (local): LLM_BASE_URL=http://localhost:11434/v1                                LLM_MODEL=qwen2.5:3b  (no key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Used by `npm run prisma:seed` (development only).
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Demo@1234"
SEED_ADMIN_EMAIL="admin@metal.local"
