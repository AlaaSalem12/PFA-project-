generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR_MANAGER
  PRODUCTION_MANAGER
  MAINTENANCE_TECH
  EMPLOYEE
}
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}
enum MachineType {
  CNC
  LATHE
  MILLING
  PRESS
  WELDING_STATION
  FURNACE
  CRANE
  CUTTING
  OTHER
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(80)
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  email        String    @unique
  role         Role
  enabled      Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  mustChangePassword Boolean @default(true) @map("must_change_password")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil  DateTime? @map("locked_until")
  refreshTokenVersion Int @default(0) @map("refresh_token_version")
  deletedAt    DateTime? @map("deleted_at")
  createdById  Int?      @map("created_by_id")
  employeeId   Int?      @unique @map("employee_id")
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdBy    User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]    @relation("UserCreatedBy")
  passwordResetTokens PasswordResetToken[]
  machineStatusLogs MachineStatusLog[] @relation("StatusChangedBy")
  maintenanceNotes MaintenanceNote[] @relation("NoteCreatedBy")
  notifications Notification[] @relation("NotificationRecipient")
  auditLogs    AuditLog[] @relation("AuditActor")
  createdMachines Machine[] @relation("MachineCreatedBy")
  createdWorkOrders WorkOrder[] @relation("WorkOrderCreatedBy")
  createdMaintenancePlans MaintenancePlan[] @relation("MaintenancePlanCreatedBy")
  assistantConversations AssistantConversation[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  @@map("app_users")
  @@index([role])
  @@index([enabled])
  @@index([deletedAt])
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(120)
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  createdBy   String?    @map("created_by")
}

model Position {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(120)
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  createdBy   String?    @map("created_by")
}

model Employee {
  id                    Int             @id @default(autoincrement())
  matricule             String          @unique @db.VarChar(40)
  firstName             String          @map("first_name")
  lastName              String          @map("last_name")
  socialSecurityNumber  String?         @unique @map("social_security_number")
  birthDate             DateTime?       @map("birth_date") @db.Date
  phone                 String?
  email                 String?
  address               String?
  hireDate              DateTime        @map("hire_date") @db.Date
  photoUrl              String?         @map("photo_url")
  status                EmployeeStatus  @default(ACTIVE)
  departmentId          Int?            @map("department_id")
  positionId            Int?            @map("position_id")
  deletedAt             DateTime?       @map("deleted_at")
  department            Department?     @relation(fields: [departmentId], references: [id])
  position              Position?       @relation(fields: [positionId], references: [id])
  user                  User?
  authorizedMachines    Machine[]       @relation("AuthorizedOperators")
  assignedWorkOrders    WorkOrder[]     @relation("AssignedWorkOrders")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  createdBy             String?         @map("created_by")
  @@index([lastName, firstName])
  @@index([status])
}

model Machine {
  id                 Int        @id @default(autoincrement())
  code               String     @unique
  name               String
  type               MachineType
  brand              String?
  model              String?
  serialNumber       String?    @unique @map("serial_number")
  purchaseDate       DateTime?  @map("purchase_date") @db.Date
  workshop           String?
  location           String?
  maintenanceStatus  MaintenanceStatus @default(OPERATIONAL) @map("maintenance_status")
  hourlyCost         Decimal?   @map("hourly_cost") @db.Decimal(12, 2)
  operatingHours     Decimal    @default(0) @map("operating_hours") @db.Decimal(12, 2)
  imageUrl           String?    @map("image_url")
  lastMaintenanceAt  DateTime? @map("last_maintenance_at")
  nextMaintenanceDueAt DateTime? @map("next_maintenance_due_at")
  maintenanceIntervalDays Int? @map("maintenance_interval_days")
  notes              String?
  deletedAt          DateTime?  @map("deleted_at")
  createdById        Int?      @map("created_by_id")
  createdBy          User?     @relation("MachineCreatedBy", fields: [createdById], references: [id])
  authorizedOperators Employee[] @relation("AuthorizedOperators")
  maintenancePlans   MaintenancePlan[]
  workOrders         WorkOrder[]
  statusLogs         MachineStatusLog[]
  maintenanceNotes   MaintenanceNote[]
  notifications      Notification[]
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  @@index([maintenanceStatus])
  @@index([nextMaintenanceDueAt])
}

enum MaintenanceStatus {
  OPERATIONAL
  SCHEDULED_MAINTENANCE
  UNDER_MAINTENANCE
  BREAKDOWN
  OUT_OF_SERVICE
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model MachineStatusLog {
  id          Int              @id @default(autoincrement())
  machineId   Int              @map("machine_id")
  fromStatus  MaintenanceStatus? @map("from_status")
  toStatus    MaintenanceStatus  @map("to_status")
  comment     String?
  changedById Int              @map("changed_by_id")
  changedAt   DateTime         @default(now()) @map("changed_at")
  machine     Machine          @relation(fields: [machineId], references: [id], onDelete: Cascade)
  changedBy   User             @relation("StatusChangedBy", fields: [changedById], references: [id])
  @@index([machineId, changedAt])
}

model MaintenanceNote {
  id          Int      @id @default(autoincrement())
  machineId   Int      @map("machine_id")
  note        String
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("NoteCreatedBy", fields: [createdById], references: [id])
  @@index([machineId, createdAt])
}

enum NotificationType {
  MACHINE_BREAKDOWN
  MACHINE_OUT_OF_SERVICE
  PASSWORD_RESET
  WORK_ORDER_ASSIGNED
  MAINTENANCE_DUE
}

model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  type       NotificationType
  title      String
  message    String
  machineId  Int?             @map("machine_id")
  workOrderId Int?            @map("work_order_id")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  machine    Machine?         @relation(fields: [machineId], references: [id], onDelete: SetNull)
  workOrder  WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)
  @@index([entity, entityId])
  @@index([createdAt])
}

model MaintenancePlan {
  id             Int      @id @default(autoincrement())
  machineId      Int      @map("machine_id")
  task           String
  frequencyDays  Int      @map("frequency_days")
  nextDueDate    DateTime @map("next_due_date") @db.Date
  createdById    Int?     @map("created_by_id")
  machine        Machine  @relation(fields: [machineId], references: [id])
  createdBy      User?    @relation("MaintenancePlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@index([machineId])
  @@index([nextDueDate])
}

enum WorkOrderType {
  PREVENTIVE
  CORRECTIVE
}
enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
}
model WorkOrder {
  id           Int              @id @default(autoincrement())
  machineId    Int              @map("machine_id")
  type         WorkOrderType
  priority     WorkOrderPriority
  assignedToId Int?             @map("assigned_to_id")
  status       WorkOrderStatus  @default(OPEN)
  openedAt     DateTime         @default(now()) @map("opened_at")
  closedAt     DateTime?        @map("closed_at")
  cost         Decimal?         @db.Decimal(12, 2)
  description  String?
  partsUsed    String?          @map("parts_used")
  resolution   String?
  createdById  Int?             @map("created_by_id")
  machine      Machine          @relation(fields: [machineId], references: [id])
  assignedTo   Employee?        @relation("AssignedWorkOrders", fields: [assignedToId], references: [id])
  createdBy    User?            @relation("WorkOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notifications Notification[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  @@index([status])
  @@index([machineId])
  @@index([assignedToId])
}

enum AssistantRole {
  USER
  ASSISTANT
  TOOL
}

model AssistantConversation {
  id        Int                @id @default(autoincrement())
  userId    Int                @map("user_id")
  title     String             @db.VarChar(120)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AssistantMessage[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             Int                   @id @default(autoincrement())
  conversationId Int                   @map("conversation_id")
  role           AssistantRole
  content        String                @db.Text
  toolName       String?               @map("tool_name")
  toolCallId     String?               @map("tool_call_id")
  toolCalls      Json?                 @map("tool_calls")
  latencyMs      Int?                  @map("latency_ms")
  createdAt      DateTime              @default(now()) @map("created_at")
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}
